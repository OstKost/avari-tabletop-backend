DATABASE_URL=postgres://tabletop:tabletop@localhost:5432/tabletop?sslmode=disable
JWT_SECRET=change-me-in-production-use-32-chars-min
PORT=8080
ENV=development

# Server-only application token from an approved BGG application. Never ship it in mobile config.
BGG_API_TOKEN=

# LLM Provider: "ollama" (default/local) | "claude" | "openai_compat" (Groq/OpenRouter)
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5
LLM_BASE_URL=http://localhost:11434

# For claude provider — use CLAUDE_API_KEY (legacy) or LLM_API_KEY
# CLAUDE_API_KEY=sk-ant-api03-...
# LLM_API_KEY=sk-ant-api03-...

# For openai_compat provider (Groq, OpenRouter, LM Studio)
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://api.groq.com/openai
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.1-8b-instant

# Embeddings (for RAG)
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
EMBED_BASE_URL=http://localhost:11434

# Vector Store: "chromem" (default, in-process gob) | "pgvector" (requires pg extension)
VECTOR_STORE=chromem
RULES_PERSIST_PATH=./data/rules

# Bounded durable AI budgets (not client defines)
CHAT_DAILY_LIMIT=50
CHAT_TIMEOUT_SECONDS=120
CHAT_MAX_OUTPUT_BYTES=131072
